# Copy to .env and fill in. .env is git-ignored.

# --- Travelpayouts Data API ---
# Affiliate token from https://www.travelpayouts.com/programs/100/tools/api
TRAVELPAYOUTS_TOKEN=replace-me
TRAVELPAYOUTS_BASE_URL=https://api.travelpayouts.com
TRAVELPAYOUTS_MARKER=replace-me-affiliate-marker
DEFAULT_CURRENCY=usd
DEFAULT_MARKET=us

# --- Postgres ---
# Matches docker-compose service "postgres".
DATABASE_URL=postgresql://farewatch:farewatch@localhost:5432/farewatch

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Ingestion ---
# Comma-separated IATA city codes to poll (curated hubs, dense data).
ORIGIN_HUBS=BOS,JFK,LAX,ORD,SFO
# How often to poll each origin's city-directions (seconds). Stay well under
# the ~200 req/hour/IP ceiling. 5 hubs every 3h = ~40 calls/day.
POLL_INTERVAL_SECONDS=10800
# Polling window granularity for observation dedup (seconds).
OBS_BUCKET_SECONDS=10800

# --- Read API (Phase 4) ---
# Comma-separated origins allowed to call the API (the Next.js dev server, etc.).
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Logging ---
LOG_LEVEL=INFO
